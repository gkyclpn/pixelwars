{
  "name": "pixelwars-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/server.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --only pixelwars",
    "pm2:dev": "pm2 start ecosystem.config.cjs --only pixelwars-dev",
    "pm2:stop": "pm2 stop pixelwars"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "p-queue": "^9.3.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "pm2": "^7.0.4",
    "typescript": "^7.0.2"
  }
}
